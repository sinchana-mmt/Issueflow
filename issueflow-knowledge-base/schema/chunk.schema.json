{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "issueflow.knowledge.chunk.v1",
  "title": "IssueFlow knowledge chunk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "docId",
    "title",
    "corpus",
    "corpusVersion",
    "source",
    "sourceVersion",
    "prdSections",
    "kind",
    "authority",
    "embed",
    "priority",
    "status",
    "entities",
    "keywords",
    "questions",
    "text",
    "sourceFile"
  ],
  "properties": {
    "docId": { "type": "string", "pattern": "^issueflow\\.prd\\.v1\\.[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "corpus": { "const": "issueflow" },
    "corpusVersion": { "const": "issueflow-prd-1.0.0" },
    "source": { "const": "IssueFlow_PRD.md" },
    "sourceVersion": { "const": "1.0" },
    "prdSections": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "kind": { "enum": ["requirement", "gap", "recommendation", "integration"] },
    "authority": { "enum": ["normative", "unspecified", "advisory"] },
    "embed": { "type": "boolean" },
    "priority": { "enum": ["P0", "P1"] },
    "status": { "enum": ["specified", "unspecified", "proposed"] },
    "entities": { "type": "array", "items": { "type": "string" } },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "questions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "text": { "type": "string", "minLength": 1 },
    "sourceFile": { "type": "string" }
  }
}
